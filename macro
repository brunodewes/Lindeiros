Function ValidarCPF(cpf As String) As Boolean
    Dim i, j, digito1, digito2 As Integer
    Dim cpfNumeros(10) As Integer
    Dim valido As Boolean
    
    ' Remove caracteres não numéricos
    cpf = Replace(cpf, ".", "")
    cpf = Replace(cpf, "-", "")
    cpf = Replace(cpf, " ", "")
    
    ' Verifica se tem 11 dígitos e se é numérico
    If Len(cpf) <> 11 Or Not IsNumeric(cpf) Then
        ValidarCPF = False
        Exit Function
    End If
    
    ' Verifica se todos os dígitos são iguais (ex: 111.111.111-11)
    For i = 1 To 10
        If Mid(cpf, i, 1) <> Mid(cpf, i + 1, 1) Then
            Exit For
        End If
    Next i
    If i = 11 Then
        ValidarCPF = False
        Exit Function
    End If
    
    ' Converte cada caractere para número
    For i = 0 To 10
        cpfNumeros(i) = CInt(Mid(cpf, i + 1, 1))
    Next i
    
    ' Cálculo do primeiro dígito verificador
    digito1 = 0
    For i = 0 To 8
        digito1 = digito1 + (cpfNumeros(i) * (10 - i))
    Next i
    digito1 = (digito1 * 10) Mod 11
    If digito1 = 10 Then digito1 = 0
    
    ' Cálculo do segundo dígito verificador
    digito2 = 0
    For i = 0 To 9
        digito2 = digito2 + (cpfNumeros(i) * (11 - i))
    Next i
    digito2 = (digito2 * 10) Mod 11
    If digito2 = 10 Then digito2 = 0
    
    ' Verifica se os dígitos estão corretos
    If digito1 = cpfNumeros(9) And digito2 = cpfNumeros(10) Then
        ValidarCPF = True
    Else
        ValidarCPF = False
    End If
End Function

Function ValidarCNPJ(cnpj As String) As Boolean
    Dim i, j, digito1, digito2 As Integer
    Dim cnpjNumeros(13) As Integer
    Dim pesos1(11) As Integer
    Dim pesos2(12) As Integer
    
    ' Remove caracteres não numéricos
    cnpj = Replace(cnpj, ".", "")
    cnpj = Replace(cnpj, "-", "")
    cnpj = Replace(cnpj, "/", "")
    cnpj = Replace(cnpj, " ", "")
    
    ' Verifica se tem 14 dígitos e se é numérico
    If Len(cnpj) <> 14 Or Not IsNumeric(cnpj) Then
        ValidarCNPJ = False
        Exit Function
    End If
    
    ' Verifica se todos os dígitos são iguais (ex: 11.111.111/1111-11)
    For i = 1 To 13
        If Mid(cnpj, i, 1) <> Mid(cnpj, i + 1, 1) Then
            Exit For
        End If
    Next i
    If i = 14 Then
        ValidarCNPJ = False
        Exit Function
    End If
    
    ' Converte cada caractere para número
    For i = 0 To 13
        cnpjNumeros(i) = CInt(Mid(cnpj, i + 1, 1))
    Next i
    
    ' Define pesos para o primeiro dígito verificador (5 a 2, depois 9 a 2)
    pesos1 = Array(5, 4, 3, 2, 9, 8, 7, 6, 5, 4, 3, 2)
    
    ' Cálculo do primeiro dígito verificador (13º dígito do CNPJ)
    digito1 = 0
    For i = 0 To 11
        digito1 = digito1 + (cnpjNumeros(i) * pesos1(i))
    Next i
    digito1 = digito1 Mod 11
    If digito1 < 2 Then
        digito1 = 0
    Else
        digito1 = 11 - digito1
    End If
    
    ' Verifica se o primeiro dígito está correto
    If digito1 <> cnpjNumeros(12) Then
        ValidarCNPJ = False
        Exit Function
    End If
    
    ' Define pesos para o segundo dígito verificador (6 a 2, depois 9 a 2)
    pesos2 = Array(6, 5, 4, 3, 2, 9, 8, 7, 6, 5, 4, 3, 2)
    
    ' Cálculo do segundo dígito verificador (14º dígito do CNPJ)
    digito2 = 0
    For i = 0 To 12
        digito2 = digito2 + (cnpjNumeros(i) * pesos2(i))
    Next i
    digito2 = digito2 Mod 11
    If digito2 < 2 Then
        digito2 = 0
    Else
        digito2 = 11 - digito2
    End If
    
    ' Verifica se o segundo dígito está correto
    If digito2 <> cnpjNumeros(13) Then
        ValidarCNPJ = False
        Exit Function
    End If
    
    ' Se passou por todas as verificações, CNPJ é válido
    ValidarCNPJ = True
End Function

Sub ValidarEFormatarCPFouCNPJ()
    Dim oSelection As Object
    Dim sTexto As String
    Dim sNumeros As String
    Dim resultado As Boolean
    Dim textoFormatado As String
    
    oSelection = ThisComponent.getCurrentSelection()
    
    If Not oSelection.supportsService("com.sun.star.text.TextRanges") Then
        MsgBox "Selecione um CPF ou CNPJ no documento.", 16, "Erro"
        Exit Sub
    End If
    
    sTexto = oSelection.getByIndex(0).getString()
    
    ' Remove caracteres não numéricos
    sNumeros = Replace(sTexto, ".", "")
    sNumeros = Replace(sNumeros, "-", "")
    sNumeros = Replace(sNumeros, "/", "")
    sNumeros = Replace(sNumeros, " ", "")
    
    If Len(sNumeros) = 11 Then
        resultado = ValidarCPF(sNumeros)
        If resultado Then
            textoFormatado = "CPF N° " & Left(sNumeros, 3) & "." & Mid(sNumeros, 4, 3) & "." & Mid(sNumeros, 7, 3) & "-" & Right(sNumeros, 2)
            oSelection.getByIndex(0).setString(textoFormatado)
        Else
            MsgBox "CPF inválido!", 16, "Validação"
        End If
        
    ElseIf Len(sNumeros) = 14 Then
        resultado = ValidarCNPJ(sNumeros)
        If resultado Then
            textoFormatado = "CNPJ N° " & Left(sNumeros, 2) & "." & Mid(sNumeros, 3, 3) & "." & Mid(sNumeros, 6, 3) & "/" & Mid(sNumeros, 9, 4) & "-" & Right(sNumeros, 2)
            oSelection.getByIndex(0).setString(textoFormatado)
        Else
            MsgBox "CNPJ inválido!", 16, "Validação"
        End If
        
    Else
        MsgBox "Texto selecionado não tem 11 (CPF) ou 14 (CNPJ) dígitos numéricos.", 48, "Aviso"
    End If
End Sub

