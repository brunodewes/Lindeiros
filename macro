Function FormatarMilhar(valor As String) As String
    Dim numero As Long
    
    If IsNumeric(valor) Then
        numero = CLng(valor)
        FormatarMilhar = Format(numero, "#,###")
    Else
        FormatarMilhar = valor
    End If
End Function


Sub ExportUniqueRowsToODT_FinalDebugged()
    On Error GoTo ErrorHandler
    
    ' ============================================================
    ' VARIÁVEIS PRINCIPAIS
    ' ============================================================
    
    Dim oDoc As Object
    Dim oSheet As Object
    Dim oODTDoc As Object
    Dim oText As Object
    Dim oCursor As Object
    
    Dim sODSPath As String
    Dim humanPath As String
    
    Dim dataArray As Variant
    Dim i As Long
    Dim j As Long
    
    Dim desc As String
    Dim mat As String
    Dim cns As String
    Dim tipoLimite As String
    Dim key As String
    
    ' ============================================================
    ' ARRAYS PARA ARMAZENAMENTO
    ' ============================================================
    
    Dim uniqueKeys()
    Dim uniqueValues()
    
    ReDim uniqueKeys(50)
    ReDim uniqueValues(50)
    
    Dim keyCount As Long
    keyCount = 0
    
    ' ============================================================
    ' DOCUMENTO ATUAL
    ' ============================================================
    
    oDoc = ThisComponent
    
    If Not oDoc.hasLocation() Then
        MsgBox "Please save your spreadsheet first!", 0, "Document Not Saved"
        Exit Sub
    End If
    
    ' ============================================================
    ' PLANILHA PERIMETRO_1
    ' ============================================================
    
    If oDoc.Sheets.getCount() < 2 Then
        MsgBox "Cannot find the required sheet!", 0, "Error"
        Exit Sub
    End If
    
    oSheet = oDoc.Sheets.getByIndex(1)
    
    ' ============================================================
    ' COLUNAS
    '
    ' I = Tipo Limite
    ' J = CNS
    ' K = Matrícula
    ' L = Descritivo
    '
    ' Índices são 0-based:
    ' I = 8
    ' J = 9
    ' K = 10
    ' L = 11
    ' ============================================================
    
    Const colTipoLimite = 8
    Const colCNS = 9
    Const colMat = 10
    Const colDesc = 11
    
    Const startRow = 11 ' Linha 12
    
    ' ============================================================
    ' PERGUNTA A ÚLTIMA LINHA
    ' ============================================================
    
    Dim lastRowInput As String
    
    lastRowInput = InputBox( _
        "Enter the last row number to include:", _
        "Manual Row Input", _
        "")
    
    If Not IsNumeric(lastRowInput) Then
        MsgBox "Invalid row number entered.", 0, "Input Error"
        Exit Sub
    End If
    
    Dim lastRow As Long
    
    lastRow = CLng(lastRowInput) - 1
    
    If lastRow < startRow Then
        MsgBox _
            "Last row must be greater than row " & (startRow + 1), _
            0, _
            "Input Error"
        Exit Sub
    End If
    
    ' ============================================================
    ' LÊ AS COLUNAS I ATÉ L
    ' ============================================================
    
    Dim oRange As Object
    
    oRange = oSheet.getCellRangeByPosition( _
        colTipoLimite, _
        startRow, _
        colDesc, _
        lastRow)
    
    dataArray = oRange.getDataArray()
    
    ' ============================================================
    ' PROCESSAMENTO DOS DADOS
    ' ============================================================
    
    For i = LBound(dataArray) To UBound(dataArray)
        
        On Error Resume Next
        
        If IsArray(dataArray(i)) Then
            
            tipoLimite = Trim(dataArray(i)(0)) ' Coluna I
            cns = Trim(dataArray(i)(1))        ' Coluna J
            mat = Trim(dataArray(i)(2))        ' Coluna K
            desc = Trim(dataArray(i)(3))       ' Coluna L
            
        Else
            
            tipoLimite = ""
            cns = ""
            mat = ""
            desc = Trim(dataArray(i))
            
        End If
        
        On Error GoTo 0
        
        If desc <> "" Then
            
            ' ====================================================
            ' VERIFICA SE A MATRÍCULA + TIPO DE LIMITE JÁ EXISTE
            '
            ' IMPORTANTE:
            ' A mesma matrícula pode aparecer novamente se o
            ' Tipo Limite for diferente.
            ' ====================================================
            
            Dim exists As Boolean
            
            exists = False
            
            For j = 0 To keyCount - 1
                
                Dim parts() As String
                
                parts = Split(uniqueKeys(j), "|")
                
                ' parts(1) = matrícula
                ' parts(2) = tipo limite
                
                If parts(1) = mat And _
                   UCase(Trim(parts(2))) = UCase(Trim(tipoLimite)) Then
                    
                    exists = True
                    Exit For
                    
                End If
                
            Next j
            
            ' ====================================================
            ' CHAVE:
            '
            ' Descritivo | Matrícula | Tipo Limite
            ' ====================================================
            
            key = desc & "|" & mat & "|" & tipoLimite
            
            If Not exists Then
                
                If keyCount >= UBound(uniqueKeys) Then
                    
                    ReDim Preserve uniqueKeys(keyCount + 50)
                    ReDim Preserve uniqueValues(keyCount + 50)
                    
                End If
                
                uniqueKeys(keyCount) = key
                
                ' uniqueValues armazena o CNS
                uniqueValues(keyCount) = cns
                
                keyCount = keyCount + 1
                
            End If
            
        End If
        
    Next i
    
    ' ============================================================
    ' VERIFICA SE ENCONTROU DADOS
    ' ============================================================
    
    If keyCount = 0 Then
        
        MsgBox _
            "No data found in columns I,J,K,L from row 12", _
            0, _
            "Error"
        
        Exit Sub
        
    End If
    
    ' ============================================================
    ' CRIA NOVO DOCUMENTO WRITER
    ' ============================================================
    
    oODTDoc = StarDesktop.loadComponentFromURL( _
        "private:factory/swriter", _
        "_blank", _
        0, _
        Array())
    
    If IsNull(oODTDoc) Then
        MsgBox "Could not create document", 0, "Error"
        Exit Sub
    End If
    
    ' ============================================================
    ' CONFIGURA MARGENS
    ' ============================================================
    
    Dim pageStyle As Object
    
    pageStyle = oODTDoc.StyleFamilies _
        .getByName("PageStyles") _
        .getByName("Standard")
    
    pageStyle.LeftMargin = 500
    pageStyle.RightMargin = 300
    pageStyle.TopMargin = 500
    pageStyle.BottomMargin = 500
    pageStyle.GutterMargin = 0
    
    ' ============================================================
    ' CABEÇALHO
    ' ============================================================
    
    pageStyle.HeaderIsOn = True
    
    Dim headerText As Object
    
    headerText = pageStyle.HeaderText
    
    If Not IsNull(headerText) Then
        
        headerText.setString("")
        
        Dim headerCursor As Object
        
        headerCursor = headerText.createTextCursor()
        
        headerCursor.setPropertyValue( _
            "CharFontName", _
            "Calibri")
        
        headerCursor.setPropertyValue( _
            "CharHeight", _
            11)
        
        headerCursor.setPropertyValue( _
            "ParaAdjust", _
            com.sun.star.style.ParagraphAdjust.LEFT)
        
        headerText.insertString( _
            headerCursor, _
            "Concordamos com as medidas apresentadas na planta constante do anverso e memorial descritivo anexo, nos espaços em que o referido imóvel faz confrontação com o imóvel de nossa propriedade. Declaramos que os limites divisórios foram respeitados." & _
            Chr(10) & Chr(10), _
            False)
        
    End If
    
    ' ============================================================
    ' TEXTO PRINCIPAL
    ' ============================================================
    
    oText = oODTDoc.getText()
    oCursor = oText.createTextCursor()
    
    If IsNull(oCursor) Then
        
        oODTDoc.close(True)
        
        MsgBox _
            "Could not create text cursor", _
            0, _
            "Error"
        
        Exit Sub
        
    End If
    
    oCursor.setPropertyValue( _
        "ParaAdjust", _
        com.sun.star.style.ParagraphAdjust.LEFT)
    
    ' ============================================================
    ' ARRAYS PARA SEPARAR:
    '
    ' 1. Itens normais
    ' 2. Itens com hífen LN1/LA3
    ' ============================================================
    
    Dim noHyphenItems()
    Dim hyphenItems()
    
    Dim noHyphenCount As Long
    Dim hyphenCount As Long
    
    noHyphenCount = 0
    hyphenCount = 0
    
    ReDim noHyphenItems(keyCount - 1)
    ReDim hyphenItems(keyCount - 1)
    
    ' ============================================================
    ' PRIMEIRA PASSAGEM:
    ' CLASSIFICA OS ITENS
    ' ============================================================
    
    Dim keyParts() As String
    Dim isHyphenItem As Boolean
    Dim tipoAtual As String
    
    For i = 0 To keyCount - 1
        
        keyParts = Split(uniqueKeys(i), "|")
        
        ' ========================================================
        ' keyParts:
        '
        ' 0 = Descritivo
        ' 1 = Matrícula
        ' 2 = Tipo Limite
        ' 3 = CNS (armazenado abaixo)
        '
        ' O CNS fica separado em uniqueValues.
        ' ========================================================
        
        tipoAtual = UCase(Trim(keyParts(2)))
        
        ' ========================================================
        ' NOVA REGRA:
        '
        ' Só é hyphenItem se:
        '
        ' 1. existir " - "
        ' E
        ' 2. Tipo Limite for LN1 ou LA3
        ' ========================================================
        
        isHyphenItem = _
            (InStr(keyParts(0), " - ") > 0) And _
            (tipoAtual = "LN1" Or tipoAtual = "LA3")
        
        If isHyphenItem Then
            
            hyphenItems(hyphenCount) = _
                uniqueKeys(i) & "|" & uniqueValues(i)
            
            hyphenCount = hyphenCount + 1
            
        Else
            
            noHyphenItems(noHyphenCount) = _
                uniqueKeys(i) & "|" & uniqueValues(i)
            
            noHyphenCount = noHyphenCount + 1
            
        End If
        
    Next i
    
    ' ============================================================
    ' REDIMENSIONA OS ARRAYS
    ' ============================================================
    
    If noHyphenCount > 0 Then
        ReDim Preserve noHyphenItems(noHyphenCount - 1)
    End If
    
    If hyphenCount > 0 Then
        ReDim Preserve hyphenItems(hyphenCount - 1)
    End If
    
    ' ============================================================
    ' PROCESSA ITENS NORMAIS PRIMEIRO
    ' ============================================================
    
    For i = 0 To noHyphenCount - 1
        
        keyParts = Split(noHyphenItems(i), "|")
        
        ' keyParts:
        ' 0 = desc
        ' 1 = matrícula
        ' 2 = tipo limite
        ' 3 = CNS
        
        ProcessItem _
            oText, _
            oCursor, _
            oODTDoc, _
            keyParts(0), _
            keyParts(1), _
            keyParts(3), _
            keyParts(2), _
            False, _
            i < noHyphenCount - 1 Or hyphenCount > 0
        
    Next i
    
    ' ============================================================
    ' PROCESSA ITENS COM HÍFEN
    ' ============================================================
    
    If hyphenCount > 0 Then
        
        Dim processedNames()
        
        ReDim processedNames(hyphenCount - 1)
        
        Dim nameCount As Long
        
        nameCount = 0
        
        For i = 0 To hyphenCount - 1
            
            keyParts = Split(hyphenItems(i), "|")
            
            ' ====================================================
            ' EXTRAI PARTE ANTES DO HÍFEN
            ' ====================================================
            
            Dim hyphenPos As Long
            
            hyphenPos = InStr(keyParts(0), "-")
            
            Dim currentName As String
            
            currentName = _
                Trim(Left(keyParts(0), hyphenPos - 1))
            
            ' ====================================================
            ' TIPO DE LIMITE
            ' ====================================================
            
            Dim currentTipo As String
            
            currentTipo = UCase(Trim(keyParts(2)))
            
            ' ====================================================
            ' GRUPO:
            '
            ' O tipo também faz parte do grupo.
            '
            ' Assim:
            '
            ' L.R. Nº X + LN1
            '
            ' é diferente de:
            '
            ' L.R. Nº X + LA3
            ' ====================================================
            
            Dim currentGroupKey As String
            
            currentGroupKey = _
                currentName & "|" & currentTipo
            
            ' ====================================================
            ' VERIFICA SE JÁ PROCESSOU ESTE GRUPO
            ' ====================================================
            
            Dim nameExists As Boolean
            
            nameExists = False
            
            For j = 0 To nameCount - 1
                
                If processedNames(j) = currentGroupKey Then
                    
                    nameExists = True
                    Exit For
                    
                End If
                
            Next j
            
            If Not nameExists Then
                
                ' =================================================
                ' ADICIONA O GRUPO
                ' =================================================
                
                processedNames(nameCount) = currentGroupKey
                nameCount = nameCount + 1
                
                ' =================================================
                ' CABEÇALHO DO GRUPO
                ' =================================================
                
                oCursor.setPropertyValue( _
                    "CharFontName", _
                    "Calibri")
                
                oCursor.setPropertyValue( _
                    "CharHeight", _
                    12)
                
                oCursor.setPropertyValue( _
                    "CharWeight", _
                    com.sun.star.awt.FontWeight.BOLD)
                
                oCursor.setPropertyValue( _
                    "CharUnderline", _
                    com.sun.star.awt.FontUnderline.SINGLE)
                
                ' =================================================
                ' LA3:
                '
                ' Confrontação do Outro lado da [nome]
                '
                ' LN1:
                '
                ' [nome], menos de 15 metros...
                ' =================================================
                
                If currentTipo = "LA3" Then
                    
                    oText.insertString( _
                        oCursor, _
                        "Confrontação do Outro lado da " & _
                        currentName & _
                        Chr(10), _
                        False)
                    
                Else
                    
                    ' LN1
                    
                    oText.insertString( _
                        oCursor, _
                        currentName & _
                        ", menos de 15 metros lineares e não navegável" & _
                        Chr(10), _
                        False)
                    
                End If
                
                oCursor.setPropertyValue( _
                    "CharHeight", _
                    8)
                
                oText.insertString( _
                    oCursor, _
                    Chr(10) & Chr(10), _
                    False)
                
                oCursor.setPropertyValue( _
                    "CharHeight", _
                    12)
                
                ' =================================================
                ' PROCESSA TODOS OS ITENS DO MESMO GRUPO
                ' =================================================
                
                For j = 0 To hyphenCount - 1
                    
                    Dim keyParts2() As String
                    
                    keyParts2 = Split(hyphenItems(j), "|")
                    
                    Dim hyphenPos2 As Long
                    
                    hyphenPos2 = _
                        InStr(keyParts2(0), "-")
                    
                    Dim itemName As String
                    
                    itemName = _
                        Trim(Left( _
                            keyParts2(0), _
                            hyphenPos2 - 1))
                    
                    Dim itemTipo As String
                    
                    itemTipo = _
                        UCase(Trim(keyParts2(2)))
                    
                    ' =================================================
                    ' MESMO NOME E MESMO TIPO
                    ' =================================================
                    
                    If itemName = currentName And _
                       itemTipo = currentTipo Then
                        
                        ProcessItem _
                            oText, _
                            oCursor, _
                            oODTDoc, _
                            keyParts2(0), _
                            keyParts2(1), _
                            keyParts2(3), _
                            keyParts2(2), _
                            True, _
                            j < hyphenCount - 1
                        
                    End If
                    
                Next j
                
            End If
            
        Next i
        
    End If
    
    ' ============================================================
    ' SALVA NA MESMA PASTA DO ODS
    ' ============================================================
    
    sODSPath = oDoc.getURL()
    
    Dim i2 As Long
    Dim pathSeparatorPos As Long
    
    pathSeparatorPos = 0
    
    For i2 = Len(sODSPath) To 1 Step -1
        
        If Mid(sODSPath, i2, 1) = "/" Then
            
            pathSeparatorPos = i2
            Exit For
            
        End If
        
    Next i2
    
    Dim fileName As String
    Dim dirPath As String
    
    If pathSeparatorPos > 0 Then
        
        dirPath = Left( _
            sODSPath, _
            pathSeparatorPos)
        
        fileName = Mid( _
            sODSPath, _
            pathSeparatorPos + 1)
        
        fileName = Left( _
            fileName, _
            Len(fileName) - 4) & ".odt"
        
        fileName = "Lindeiros " & fileName
        
        humanPath = dirPath & fileName
        
    Else
        
        humanPath = "Lindeiros Resultado.odt"
        
    End If
    
    ' ============================================================
    ' PROPRIEDADES DE SALVAMENTO
    ' ============================================================
    
    Dim fileProps(0) As New com.sun.star.beans.PropertyValue
    
    fileProps(0).Name = "FilterName"
    fileProps(0).Value = "writer8"
    
    On Error Resume Next
    
    oODTDoc.storeAsURL( _
        ConvertToURL(humanPath), _
        fileProps)
    
    If Err Then
        
        MsgBox _
            "Error saving file: " & _
            Err & _
            " - " & _
            Error$, _
            0, _
            "Error"
        
        oODTDoc.close(True)
        
        Exit Sub
        
    End If
    
    On Error GoTo 0
    
    Exit Sub
    
ErrorHandler:
    
    MsgBox _
        "Error " & _
        Err & _
        ": " & _
        Error$, _
        0, _
        "Macro Error"
    
    If Not IsNull(oODTDoc) Then
        oODTDoc.close(True)
    End If
    
End Sub


Sub ProcessItem( _
    oText As Object, _
    oCursor As Object, _
    oODTDoc As Object, _
    desc As String, _
    mat As String, _
    cns As String, _
    tipoLimite As String, _
    isHyphenItem As Boolean, _
    addSeparator As Boolean)

    Dim registryOffice As String
    
    registryOffice = MapCNS(cns)
    
    ' ============================================================
    ' VERIFICA SE HÁ MÚLTIPLAS MATRÍCULAS
    ' ============================================================
    
    Dim matriculas() As String
    
    matriculas = Split(mat, ",")
    
    ' ============================================================
    ' NORMALIZAÇÃO DA DESCRIÇÃO
    ' ============================================================
    
    Dim descTratada As String
    
    descTratada = desc
    
    descTratada = Replace( _
        descTratada, _
        "L. R.", _
        "Lote Rural")
    
    descTratada = Replace( _
        descTratada, _
        "L.R.", _
        "Lote Rural")
    
    descTratada = Replace( _
        descTratada, _
        "Pte", _
        "Parte")
    
    ' Permite separar itens por " e "
    descTratada = Replace( _
        descTratada, _
        " e ", _
        ",")
    
    ' ============================================================
    ' PROCESSA CADA MATRÍCULA
    ' ============================================================
    
    Dim i As Long
    
    For i = 0 To UBound(matriculas)
        
        Dim currentMat As String
        
        currentMat = Trim(matriculas(i))
        
        ' ========================================================
        ' FORMATAÇÃO
        ' ========================================================
        
        oCursor.setPropertyValue( _
            "CharFontName", _
            "Calibri")
        
        oCursor.setPropertyValue( _
            "CharHeight", _
            12)
        
        oCursor.setPropertyValue( _
            "CharWeight", _
            com.sun.star.awt.FontWeight.BOLD)
        
        oCursor.setPropertyValue( _
            "CharUnderline", _
            com.sun.star.awt.FontUnderline.SINGLE)
        
        ' ========================================================
        ' ITEM COM HÍFEN
        ' ========================================================
        
        If isHyphenItem Then
            
            ' Para itens com hífen, usa somente a parte
            ' depois do hífen como confrontante.
            
            Dim hyphenPos As Long
            
            hyphenPos = InStr(descTratada, "-")
            
            Dim partAfter As String
            
            partAfter = _
                Trim(Mid( _
                    descTratada, _
                    hyphenPos + 1))
            
            Dim descParts() As String
            
            descParts = Split(partAfter, ",")
            
            ' ====================================================
            ' VÁRIAS MATRÍCULAS / VÁRIAS DESCRIÇÕES
            ' ====================================================
            
            If UBound(matriculas) > 0 And _
               UBound(descParts) > 0 Then
                
                If i <= UBound(descParts) Then
                    
                    Dim currentDescPart As String
                    
                    currentDescPart = _
                        Trim(descParts(i))
                    
                    oText.insertString( _
                        oCursor, _
                        currentDescPart & _
                        " — Matrícula N° " & _
                        FormatarMilhar(currentMat) & _
                        " — " & _
                        registryOffice & _
                        Chr(10) & Chr(10), _
                        False)
                    
                End If
                
            Else
                
                oText.insertString( _
                    oCursor, _
                    partAfter & _
                    " — Matrícula N° " & _
                    FormatarMilhar(currentMat) & _
                    " — " & _
                    registryOffice & _
                    Chr(10) & Chr(10), _
                    False)
                
            End If
            
        Else
            
            ' ====================================================
            ' ITEM SEM HÍFEN
            ' ====================================================
            
            Dim descPartsSemHifen() As String
            
            descPartsSemHifen = _
                Split(descTratada, ",")
            
            If UBound(matriculas) > 0 And _
               UBound(descPartsSemHifen) > 0 Then
                
                If i <= UBound(descPartsSemHifen) Then
                    
                    oText.insertString( _
                        oCursor, _
                        Trim(descPartsSemHifen(i)) & _
                        " — Matrícula N° " & _
                        FormatarMilhar(currentMat) & _
                        " — " & _
                        registryOffice & _
                        Chr(10) & Chr(10), _
                        False)
                    
                End If
                
            Else
                
                oText.insertString( _
                    oCursor, _
                    Trim(descTratada) & _
                    " — Matrícula N° " & _
                    FormatarMilhar(currentMat) & _
                    " — " & _
                    registryOffice & _
                    Chr(10) & Chr(10), _
                    False)
                
            End If
            
        End If
        
        ' ========================================================
        ' VOLTA PARA FORMATAÇÃO NORMAL
        ' ========================================================
        
        oCursor.setPropertyValue( _
            "CharWeight", _
            com.sun.star.awt.FontWeight.NORMAL)
        
        oCursor.setPropertyValue( _
            "CharUnderline", _
            com.sun.star.awt.FontUnderline.NONE)
        
        ' ========================================================
        ' CAMPO NOME
        ' ========================================================
        
        Dim textField1 As Object
        
        textField1 = _
            oODTDoc.createInstance( _
                "com.sun.star.text.TextField.Input")
        
        textField1.Content = "Nome"
        
        oText.insertTextContent( _
            oCursor, _
            textField1, _
            False)
        
        ' ========================================================
        ' SEPARADOR
        ' ========================================================
        
        oText.insertString( _
            oCursor, _
            " — ", _
            False)
        
        ' ========================================================
        ' CAMPO CPF/CNPJ
        ' ========================================================
        
        Dim textField2 As Object
        
        textField2 = _
            oODTDoc.createInstance( _
                "com.sun.star.text.TextField.Input")
        
        textField2.Content = "CPF/CNPJ"
        
        oText.insertTextContent( _
            oCursor, _
            textField2, _
            False)
        
        ' ========================================================
        ' TAMANHO 8
        ' ========================================================
        
        oCursor.setPropertyValue( _
            "CharHeight", _
            8)
        
        ' ========================================================
        ' ESPAÇO ANTES DA ASSINATURA
        ' ========================================================
        
        oText.insertString( _
            oCursor, _
            Chr(10) & _
            Chr(10) & _
            Chr(10) & _
            Chr(10) & _
            Chr(10), _
            False)
        
        ' ========================================================
        ' LINHA DA ASSINATURA
        ' ========================================================
        
        oText.insertString( _
            oCursor, _
            "________________________________________", _
            False)
        
        ' ========================================================
        ' ESPAÇO ANTES DO TERMO
        ' ========================================================
        
        oText.insertString( _
            oCursor, _
            Chr(10) & Chr(10), _
            False)
        
        ' ========================================================
        ' TERMO DE ANUÊNCIA
        ' ========================================================
        
        oText.insertString( _
            oCursor, _
            """Estou ciente de que, nos termos do §10 do artigo 213 da LRP, minha anuência supre a participação do cônjuge e de eventuais outros condôminos titulares de nosso imóvel.""" & _
            Chr(10), _
            False)
        
        ' ========================================================
        ' SEPARAÇÃO ENTRE ITENS
        ' ========================================================
        
        If i < UBound(matriculas) Or addSeparator Then
            
            oText.insertString( _
                oCursor, _
                Chr(10) & Chr(10), _
                False)
            
        End If
        
    Next i
    
End Sub
